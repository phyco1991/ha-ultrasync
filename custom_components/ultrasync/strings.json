{
  "config": {
    "flow_title": "UltraSync System: {name}",
    "step": {
      "user": {
        "title": "Connect to UltraSync System",
        "description": "Enter the connection details for your system. You should use the IP address of the system on your network as the host value. Only select cloud login if you are unable to connect to your system locally.",
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "pin": "[%key:common::config_flow::data::pin%]",
          "online": "Use Cloud Login"
        }
      },
      "cloud": {
        "title": "Cloud Login",
        "description": "Enter your cloud login details for UltraSync Online. You can obtain these from your local web portal, if access is disabled you must put the system into programming mode first.",
        "data": {
          "serial_number": "Serial Number",
          "passcode": "Web Access Passcode"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "UltraSync Options",
        "description": "Update your UltraSync Hub settings.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "pin": "[%key:common::config_flow::data::pin%]",
          "online": "Use Cloud Login?",
          "scan_interval": "Update frequency (seconds)"
        }
      },
      "cloud": {
        "title": "Cloud Login Options",
        "description": "Update your UltraSync cloud login details.",
        "data": {
          "serial_number": "Serial Number",
          "passcode": "Web Access Passcode"
        }
      }
    }
  }
}
